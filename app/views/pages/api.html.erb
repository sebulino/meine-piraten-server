<h2 id="general">General</h2>
<ul>
  <li><strong>Base URL:</strong> <code>https://meine-piraten.de</code></li>
  <li><strong>Format:</strong> JSON &mdash; append <code>.json</code> to any endpoint or send <code>Accept: application/json</code></li>
</ul>

<h3>Permission Levels</h3>
<table>
  <thead>
    <tr><th>Level</th><th>Description</th></tr>
  </thead>
  <tbody>
    <tr><td><strong>Public</strong></td><td>No authentication required</td></tr>
    <tr><td><strong>Any authenticated user</strong></td><td>Valid Bearer token required</td></tr>
    <tr><td><strong>Admin</strong></td><td>User with admin flag set to true</td></tr>
    <tr><td><strong>Superadmin</strong></td><td>User with superadmin flag set to true</td></tr>
  </tbody>
</table>

<h3>Common Response Status Codes</h3>
<table>
  <thead>
    <tr><th>Status</th><th>Meaning</th></tr>
  </thead>
  <tbody>
    <tr><td><code>200</code></td><td>OK &mdash; successful GET, PATCH, PUT</td></tr>
    <tr><td><code>201</code></td><td>Created &mdash; successful POST</td></tr>
    <tr><td><code>204</code></td><td>No Content &mdash; successful DELETE</td></tr>
    <tr><td><code>401</code></td><td>Unauthorized &mdash; missing or invalid token</td></tr>
    <tr><td><code>403</code></td><td>Forbidden &mdash; insufficient permissions</td></tr>
    <tr><td><code>404</code></td><td>Not Found &mdash; resource does not exist</td></tr>
    <tr><td><code>422</code></td><td>Unprocessable Entity &mdash; validation errors</td></tr>
  </tbody>
</table>

